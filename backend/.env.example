NODE_ENV=development
PORT=5000

# Concurrency (in-process limiter for bulk downloads)
BULK_CONCURRENCY=2

# Tool paths
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
DOWNLOAD_TIMEOUT_MS=600000

# Temporary storage scratch path (defaults to os.tmpdir()/media-downloader)
# TEMP_DIR=/tmp/media-downloader

# CORS
FRONTEND_URL=http://localhost:3000

# Optional YouTube cookies (Netscape format string or file path) to bypass cloud/datacenter IP bot challenges on Render
# YOUTUBE_COOKIES=